# audit: the slack audit log, tailed and backfilled a day at a time. long running
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=audit

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
INTERNAL_PROXY_URL=
INTERNAL_PROXY_TOKEN=

# optional
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=
AUDIT_BACKFILL=
AUDIT_BACKFILL_SECONDS=120
AUDIT_HORIZON_DAYS=90
AUDIT_NEMO_ID=
AUDIT_TAIL_ACTIONS=
AUDIT_TAIL_SECONDS=60
PROXY_ALLOW_PLAINTEXT=
TZ=UTC
