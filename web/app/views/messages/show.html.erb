<% content_for :page_title, "How it did" %>
<% content_for :page_face do %>
  <span class="crumb">
    <% if @channel %>
      <%= link_to "##{@channel.name}", channel_path(@channel.channel_id) %> /
    <% else %>
      <span class="mono"><%= @channel_id %></span> /
    <% end %>
  </span>
<% end %>

<% content_for :head_actions do %>
  <%= open_in_slack Fd::SlackLink.url_for(@channel_id, @ts) %>
<% end %>

<% if @post && @activity&.stats %>
  <% content_for :page_tabs do %>
    <% Messages::Activity::SPANS.each do |key, label| %>
      <%= link_to label, message_activity_path(@channel_id, @ts, span: key), class: "view",
            aria: { current: ("true" if @span == key) } %>
    <% end %>
  <% end %>
<% end %>

<% if !@shown %>
  <div class="lede">
    <span class="lede-said">
      <b>This channel does not show how posts did</b>
      <span>A community manager can turn it on from the channels admin.</span>
    </span>
  </div>
<% elsif @post.nil? %>
  <div class="lede">
    <span class="lede-said">
      <b>Not landed yet</b>
      <span>
        The archive picks up new posts every few minutes and the warehouse follows a little
        after. Try again shortly, or ask nemo in Slack: the modal reads live.
      </span>
    </span>
  </div>
<% elsif @post.is_reply %>
  <div class="lede">
    <span class="lede-said">
      <b>That is a reply</b>
      <span>Activity is counted on top-level posts only.</span>
    </span>
  </div>
<% else %>
  <% stats = @activity.stats %>
  <div class="stack">
    <div class="metrics you-band">
      <div class="you-who">
        <%= face(@post.author_id, css: "avatar av-band") %>
        <span class="two-line">
          <b class="mono"><%= person_name(@post.author_id) %></b>
          <span>
            posted <%= on_day(@post.posted_at) %> at
            <%= @post.posted_at.in_time_zone(viewer_zone).strftime("%-l:%M %p") %>
            <% if @channel %>in #<%= @channel.name %><% end %>
          </span>
        </span>
      </div>

      <% if stats %>
        <div class="metric">
          <span class="metric-k">Viewers</span>
          <span class="metric-v"><%= number_with_delimiter(stats.viewers) %></span>
          <span class="metric-say">
            <% share = share_pct(stats.viewers, @crowd) %>
            <% if share %>
              <%= number_to_percentage(share, precision: 0) %> of the channel
            <% else %>
              unique people, counted by Slack
            <% end %>
          </span>
        </div>
        <div class="metric">
          <span class="metric-k">Reacted</span>
          <span class="metric-v"><%= number_with_delimiter(stats.reacted) %></span>
          <span class="metric-say"><%= number_with_delimiter(@post.reaction_count.to_i) %> reactions in all</span>
        </div>
        <div class="metric">
          <span class="metric-k">Clicked a link</span>
          <span class="metric-v"><%= number_with_delimiter(stats.clicked) %></span>
          <span class="metric-say"><%= number_with_delimiter(stats.shared) %> shared it</span>
        </div>
        <div class="metric">
          <span class="metric-k">Replies</span>
          <span class="metric-v"><%= number_with_delimiter(@post.reply_count.to_i) %></span>
          <span class="metric-say">
            from <%= pluralize(@post.reply_users_count.to_i, "person", plural: "people") %>
            <% if stats.top_reply_ts %>
              <span class="triad-sep">&middot;</span>
              <%= link_to "top reply", "#{Fd::SlackLink.url_for(@channel_id, stats.top_reply_ts)}?thread_ts=#{@ts}&cid=#{@channel_id}",
                    target: "_blank", rel: "noopener" %>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>

    <% if stats.nil? %>
      <div class="lede">
        <span class="lede-said">
          <b>Slack would not say how it did</b>
          <span>
            <% if @activity.error == :not_configured %>
              The analytics proxy is not configured on this deployment.
            <% elsif @activity.error == :reauth %>
              The analytics session needs refreshing. Tell whoever runs the proxy.
            <% elsif @activity.error == :not_found %>
              Slack has no activity for this post. It may be too new, or the channel too small.
            <% else %>
              Try again in a minute.
            <% end %>
          </span>
        </span>
      </div>
    <% elsif stats.any_curve? %>
      <div class="card">
        <div class="card-head">
          <div>
            <h2 class="card-title">Viewers over the <%= Messages::Activity::SPANS[@span].downcase %></h2>
            <p class="card-sub">
              <%= number_with_delimiter(stats.seen_within(@span)) %> people saw it<%= " so far" if stats.partial?(@span) %>
              <span class="triad-sep">&middot;</span>
              busiest moment <%= number_with_delimiter(stats.peak(@span)) %> new viewers
            </p>
          </div>
        </div>
        <div data-controller="chart"
             data-chart-kind-value="line"
             data-chart-height-value="260"
             data-chart-nokey-value="true"
             data-chart-data-value="<%= stats.chart(@span).to_json %>"></div>
        <p class="chart-note">new unique viewers per bucket, counted from the moment of posting</p>
      </div>

      <div class="card card-flush">
        <div class="card-head">
          <div><h2 class="card-title">Where they read it</h2></div>
        </div>
        <dl class="facts-strip facts-wrap">
          <% stats.clients.each do |label, count, share| %>
            <div class="fact">
              <dt><%= label %></dt>
              <dd>
                <%= share ? number_to_percentage(share, precision: 0) : "n/a" %>
                <small><%= number_with_delimiter(count) %></small>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>
<% end %>
