<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Slow mode</h2>
    <div class="card-tools">
      <% if guard %>
        <%= opens_modal "channel.guard", "Exempt somebody", opens: "allow-bot",
              css: "btn btn-sm" %>
      <% end %>
      <%= channel_guard_switch(channel_id, guard, kind: Fd::ChannelGuard::SLOWMODE) %>
    </div>
  </div>

  <% if guard %>
    <div class="card-body">
      <%= form_with url: fd_channel_guard_path(channel_id, guard.kind), method: :patch do %>
        <div class="ivrow">
          <label class="field-label">
            Seconds
            <%= number_field_tag :seconds, guard.seconds, class: "input", id: nil,
                  min: 1, max: Fd::ChannelGuard::SLOWEST %>
          </label>
          <label class="opt">
            <%= check_box_tag :threads, "1", guard.threads?, class: "tick", id: nil %>
            <span class="opt-body"><span class="opt-label">Threads too</span></span>
          </label>
          <%= submit_tag "Save", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
    <%= render "allows", channel_id: channel_id, guard: guard, allows: allows,
          empty: "Nobody is exempt" %>
  <% else %>
    <div class="empty"><p class="empty-title">Off</p></div>
  <% end %>
</div>
