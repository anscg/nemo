<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">New accounts</h2>
    <div class="card-tools">
      <%= channel_guard_switch(channel_id, guard, kind: Fd::ChannelGuard::ACCOUNT_AGE) %>
    </div>
  </div>

  <% if guard %>
    <div class="card-body">
      <%= form_with url: fd_channel_guard_path(channel_id, guard.kind), method: :patch do %>
        <div class="ivrow">
          <label class="field-label">
            Days old
            <%= number_field_tag :min_age_days, guard.min_age_days, class: "input", id: nil,
                  min: 1, max: Fd::ChannelGuard::OLDEST %>
          </label>
          <%= submit_tag "Save", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty"><p class="empty-title">Off</p></div>
  <% end %>
</div>
