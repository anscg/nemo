<%= turbo_frame_tag "action-standing" do %>
  <% guard = standing&.guard %>
  <% if guard %>
    <div class="flag <%= guard.failed? ? "flag-crit" : "flag-mid" %>">
      <span class="flag-icon" aria-hidden="true">◆</span>
      <div>
        <b><%= guard_standing_line(guard, kase.id, names) %></b>
        <span class="sub"><%= guard_footnote(guard, names) %></span>
      </div>
    </div>
  <% end %>
  <% options = settle_options(standing, type_key) %>
  <% if options.any? %>
    <div class="field-label">
      <span>Enforcement</span>
      <div class="segmented seg-radio">
        <% options.each do |value, said| %>
          <label>
            <%= radio_button_tag :settle, value, value == settle_default(standing), id: nil %>
            <%= said %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
