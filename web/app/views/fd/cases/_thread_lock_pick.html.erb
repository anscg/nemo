<div class="field-label" data-action-standing-target="locks" hidden>
  <span>Which thread lock</span>
  <% if locks.any? %>
    <div class="optlist">
      <% locks.each do |guard| %>
        <label class="opt">
          <%= radio_button_tag :thread_guard_id, guard.id, false, id: nil %>
          <span class="opt-dot" aria-hidden="true"></span>
          <span class="opt-body">
            <span class="opt-label"><%= thread_guard_line(guard) %></span>
            <span class="opt-note"><%= thread_lock_note(guard, kase.id) %></span>
          </span>
        </label>
      <% end %>
    </div>
  <% else %>
    <p class="card-note">
      Nothing is locked right now. Lock a thread from Slack, then log it here.
    </p>
  <% end %>
</div>
