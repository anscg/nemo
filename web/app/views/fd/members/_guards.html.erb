<%= render layout: "fd/modal", locals: { id: "member-guard", title: "Take action",
      sub: member, open: params[:do] == "guard" } do %>
  <%= form_with url: fd_member_guards_path(user_id), method: :post,
        html: { autocomplete: "off", data: { controller: "guard-form",
                action: "change->guard-form#fit" } } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>What to hold</span>
        <%= render "shared/choice", name: :kind,
              chosen: action_label(Fd::MemberGuard::KINDS.first),
              options: Fd::MemberGuard::KINDS.each_with_index.map { |key, i| {
                value: key, label: action_label(key), current: i.zero? } } %>
      </div>

      <div class="field-label" data-guard-form-target="channel" hidden>
        <span>Which channel</span>
        <%= render "fd/channel_field", name: :channel_id, label: "search for a channel" %>
      </div>

      <label class="field-label">
        Until when
        <%= date_field_tag :expires_on, nil, class: "input", id: nil %>
      </label>

      <label class="field-label">
        Why
        <%= text_area_tag :reason, field_was(:reason), rows: 3, class: "textarea", id: nil %>
      </label>
      <%= field_wrong(:reason) %>

      <div class="field-label">
        <span>Enforcement</span>
        <div class="segmented seg-radio">
          <label>
            <%= radio_button_tag :settle, Fd::MemberGuard::CARRY, true, id: nil %>
            Take action
          </label>
          <label>
            <%= radio_button_tag :settle, Fd::MemberGuard::ALREADY_DONE, false, id: nil %>
            Already taken (records only)
          </label>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Hold it", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<% guards.each do |guard| %>
  <%= render layout: "fd/modal", locals: { id: "guard-lift-#{guard.id}", title: "Lift it",
        sub: member, open: false } do %>
    <%= form_with url: fd_member_guard_path(user_id, guard), method: :delete,
          html: { autocomplete: "off" } do %>
      <div class="modal-body">
        <p class="modal-note">It stops standing. The record keeps it, and what it was for.</p>
        <label class="field-label">
          Why it is being lifted
          <%= text_area_tag :lift_reason, nil, rows: 3, class: "textarea", id: nil %>
        </label>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
        <%= submit_tag "Lift it", class: "btn btn-danger" %>
      </div>
    <% end %>
  <% end %>
<% end %>
