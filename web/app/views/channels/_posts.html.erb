<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Your posts</h2>
      <p class="card-sub">the last <%= Channels::Posts::SHOWN %>, read from Slack as you look</p>
    </div>
  </div>

  <% if posts.any? %>
    <% posts.each do |post| %>
      <div class="evrow">
        <div class="post-said">
          <% if post.message %>
            <%= Slack::RichText.for(post.message, names: names, channels: rooms) %>
          <% else %>
            <p class="msg-gone">Slack would not answer for this one.</p>
          <% end %>
          <p class="member-event-by">
            <%= pluralize(post.reactions, "reaction") %>
            <span class="triad-sep">&middot;</span>
            <%= pluralize(post.replies, "reply", plural: "replies") %>
          </p>
        </div>
        <div class="evrow-right">
          <%= link_to post.posted_at.strftime("%-d %b"),
                message_activity_path(post.channel_id, post.ts), class: "post-open" %>
        </div>
      </div>
    <% end %>

    <p class="card-note">
      For an older post, open it in Slack and use <b>View message activity</b>.
    </p>
  <% else %>
    <div class="empty">
      <p class="empty-title">You have not posted here.</p>
    </div>
  <% end %>
</div>
